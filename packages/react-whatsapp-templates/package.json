{
  "name": "react-whatsapp-templates",
  "version": "0.0.0",
  "description": "A React DSL for authoring WhatsApp message templates.",
  "type": "module",
  "sideEffects": false,
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --clean"
  },
  "dependencies": {
    "@react-whatsapp-templates/components": "workspace:*",
    "@react-whatsapp-templates/core": "workspace:*",
    "@react-whatsapp-templates/render": "workspace:*",
    "@react-whatsapp-templates/validate": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18"
  }
}
